{
  "name": "@ar-openclaw/meta-raybans",
  "version": "0.1.0",
  "description": "OpenClaw plugin for Meta Ray-Ban smart glasses via Device Access Toolkit",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": {
      "ar-openclaw-meta-raybans": {
        "entry": "dist/index.js"
      }
